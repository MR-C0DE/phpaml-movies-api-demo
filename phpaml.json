{
    "name": "phpaml-movies-api-demo",
    "version": "1.4.0",
    "description": "Read-only REST API for a movie catalog, built with PHPAML",
    "application": {
        "type": "api",
        "debug": false,
        "session": {
            "lifetime": 7200,
            "same_site": "Lax"
        },
        "rate_limit": {
            "enabled": true,
            "limit": 60,
            "window": 60
        },
        "middlewares": [
            "PHPAML\\Middleware\\SecurityHeadersMiddleware"
        ]
    },
    "database": {
        "dsn": "sqlite:runtime/storage/database.sqlite",
        "username": "root",
        "password": ""
    },
    "runtime": {
        "directory": "runtime",
        "framework": "0.3.0-beta.1"
    },
    "scripts": {
        "start": "aml serve",
        "test": "aml test"
    },
    "requirements": {
        "php": "^8.2"
    },
    "modules": []
}
