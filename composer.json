{
    "name": "phpaml/phpaml",
    "description": "Micro-framework MVC inspiré d'ASP.NET et Java EE",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PHPAML\\": "runtime/framework/",
            "App\\": "src/",
            "App\\Controllers\\": "src/controllers/",
            "App\\Models\\": "src/models/",
            "App\\Repositories\\": "src/repositories/",
            "App\\Routes\\": "src/routes/"
        }
    },
    "config": {
        "vendor-dir": "runtime",
        "sort-packages": true
    },
    "scripts": {
        "test": "php tests/run.php",
        "analyse": "phpstan analyse"
    }
}
